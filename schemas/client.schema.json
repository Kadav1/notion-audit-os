{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notion-audit-os.local/schemas/client.schema.json",
  "title": "Client",
  "description": "A client record audited by notion-audit-os.",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_id", "client_name", "slug", "created_at"],
  "properties": {
    "client_id": { "$ref": "common.schema.json#/$defs/client_id" },
    "client_name": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "slug": { "$ref": "common.schema.json#/$defs/slug" },
    "primary_contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" }
      }
    },
    "team_size": { "type": "integer", "minimum": 1 },
    "notion_plan": { "$ref": "common.schema.json#/$defs/notion_plan" },
    "segment": { "type": "string" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
