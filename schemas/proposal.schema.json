{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notion-audit-os.local/schemas/proposal.schema.json",
  "title": "Proposal",
  "description": "Engagement proposal aligned with the audit's recommended package.",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "recommended_package", "scope_summary", "generated_at"],
  "properties": {
    "audit_id": { "$ref": "common.schema.json#/$defs/audit_id" },
    "recommended_package": { "$ref": "common.schema.json#/$defs/recommended_package" },
    "scope_summary": { "type": "string" },
    "deliverables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exclusions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
